# Application
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# CORS
ALLOWED_ORIGINS=https://your-frontend.com,http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=quickbite
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_SSL_REJECT_UNAUTHORIZED=true

# Database Read Replica (Optional)
DB_READ_REPLICA_HOST=localhost
DB_REPLICA_PORT=5432
DB_REPLICA_USERNAME=postgres
DB_REPLICA_PASSWORD=your_password
DB_REPLICA_DATABASE=quickbite

# Redis (Required for Queue & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# Email (Mailtrap for development)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@quickbite.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# File upload limits
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# Admin credentials
ADMIN_EMAIL=admin@quickbite.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Super Admin

# Sentry (optional)
SENTRY_DSN=

# Rate Limits (requests per minute)
RATE_LIMIT_PROFILE_GET=60
RATE_LIMIT_PROFILE_UPDATE=10
RATE_LIMIT_PASSWORD_CHANGE=5
RATE_LIMIT_ACCOUNT_DELETE=2